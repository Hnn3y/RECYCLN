# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public, URL-restricted Mapbox token used by the browser for map tiles.
# Create a token at https://account.mapbox.com/access-tokens/ and restrict it to your app domains.
# This VITE_ variable is bundled into the frontend; never put a secret/server token here.
VITE_MAPBOX_ACCESS_TOKEN=""
MAPBOX_API_KEY=""
OPENROUTESERVICE_API_KEY=""

# NASA API key for api.nasa.gov endpoints. Request one at https://api.nasa.gov/.
# NASA EOSDIS GIBS map tiles used for VIIRS imagery are public and do not use this key.
NASA_OPEN_API=""

# Optional Copernicus Data Space OAuth credentials (not used by the NASA imagery flow)
SENTINEL_HUB_CLIENT_ID=""
SENTINEL_HUB_CLIENT_SECRET=""

# AI / Vision: Gemini currently powers the app's Copilot and image scanner.
# Generic provider keys below are reserved for a provider-specific adapter.
LLM_API_KEY=""
VISION_MODEL_API_KEY=""

# Messaging and email service credentials (server-side only)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""

# Payments (server-side; payment/escrow workflow adapter not yet active)
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""

# Object storage (server-side; S3 upload adapter not yet active)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-1"
AWS_S3_BUCKET=""

# Production data services (not wired; current server uses local JSON storage)
DATABASE_URL=""
REDIS_URL=""
JWT_SECRET=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


